# =============================================
# Content Remix AI - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================
# DATABASE
# =============================================
# SQLite (default for development)
DATABASE_URL="file:./dev.db"
# PostgreSQL (for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/content_remix_ai"

# =============================================
# AUTHENTICATION
# =============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# =============================================
# AI TEXT PROVIDER
# =============================================
# Options: mock, openai, gemini
AI_TEXT_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# =============================================
# SPEECH-TO-TEXT PROVIDER
# =============================================
# Options: mock, whisper, google
STT_PROVIDER="mock"
WHISPER_API_KEY=""
GOOGLE_STT_CREDENTIALS=""

# =============================================
# TEXT-TO-SPEECH PROVIDER
# =============================================
# Options: mock, elevenlabs, google
TTS_PROVIDER="mock"
ELEVENLABS_API_KEY=""
GOOGLE_TTS_CREDENTIALS=""

# =============================================
# IMAGE GENERATION PROVIDER
# =============================================
# Options: mock, dalle, stability
IMAGE_GEN_PROVIDER="mock"
DALLE_API_KEY=""
STABILITY_API_KEY=""

# =============================================
# STOCK MEDIA PROVIDER
# =============================================
# Options: mock, pexels, pixabay
STOCK_PROVIDER="mock"
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# =============================================
# YOUTUBE API (OAuth 2.0)
# =============================================
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/connections/youtube/callback"

# =============================================
# TIKTOK API (OAuth 2.0)
# =============================================
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/connections/tiktok/callback"

# =============================================
# FILE STORAGE
# =============================================
# Options: local, s3
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="500"
# S3-compatible storage
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# =============================================
# FFMPEG
# =============================================
# Path to FFmpeg binary (leave empty to auto-detect)
FFMPEG_PATH=""
# Use mock renderer if FFmpeg is not available
FFMPEG_MOCK="true"

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="30"
PUBLISH_RATE_LIMIT_PER_HOUR="5"

# =============================================
# APPLICATION
# =============================================
NODE_ENV="development"
APP_URL="http://localhost:3000"
SIMILARITY_THRESHOLD="70"
